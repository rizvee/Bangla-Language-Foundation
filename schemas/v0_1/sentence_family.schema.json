{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bangla-language-foundation.org/schemas/v0_1/sentence_family.schema.json",
  "title": "BLFSentenceFamily",
  "description": "Schema for structured sentence families grouping constrained realizations of a semantic proposition.",
  "type": "object",
  "required": [
    "sentence_family_id",
    "proposition_description",
    "semantic_frame_id",
    "primary_construction_id",
    "primary_predicate",
    "communicative_intent",
    "thematic_roles",
    "canonical_utterance",
    "variants",
    "quality_tier",
    "human_review_status"
  ],
  "properties": {
    "sentence_family_id": {
      "type": "string",
      "pattern": "^SF-[A-Z0-9_-]+$",
      "description": "Unique sentence family identifier (e.g. SF-00001)."
    },
    "proposition_description": {
      "type": "string",
      "description": "English description of the core underlying semantic proposition."
    },
    "semantic_frame_id": {
      "type": "string",
      "pattern": "^FRAME-[A-Z0-9_-]+$",
      "description": "ID of underlying semantic frame."
    },
    "primary_construction_id": {
      "type": "string",
      "pattern": "^CONST-[A-Z0-9_-]+$",
      "description": "Primary syntactic construction ID."
    },
    "primary_predicate": {
      "type": "string",
      "description": "Primary verb root or lexical predicate."
    },
    "communicative_intent": {
      "type": "string",
      "description": "Core dialogue act or communicative intent."
    },
    "thematic_roles": {
      "type": "object",
      "description": "Mapping of semantic roles to argument values."
    },
    "canonical_utterance": {
      "type": "string",
      "description": "The canonical BDSB surface realization."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant_type", "text", "construction_id", "register", "polarity", "provenance_type"],
        "properties": {
          "variant_type": {
            "type": "string",
            "enum": [
              "CANONICAL_DECLARATIVE",
              "POLAR_QUESTION",
              "WH_QUESTION",
              "NEGATIVE_ASSERTION",
              "HONORIFIC_APNI",
              "FAMILIAR_TUMI",
              "INTIMATE_TUI",
              "PRO_DROP_SUBJECT",
              "TOPICALIZED_OSV",
              "COMPLEX_PREDICATE_VECTOR",
              "EMPHATIC_FOCUS_CLITIC",
              "MINIMAL_PAIR_NEGATIVE"
            ]
          },
          "text": {"type": "string"},
          "construction_id": {"type": "string", "pattern": "^CONST-[A-Z0-9_-]+$"},
          "register": {"type": "string"},
          "polarity": {"type": "string", "enum": ["AFFIRMATIVE", "NEGATIVE"]},
          "provenance_type": {
            "type": "string",
            "enum": ["RULE_GENERATED", "SOURCE_EXAMPLE", "HUMAN_CREATED", "PUBLIC_DOMAIN_EXAMPLE"]
          },
          "notes": {"type": ["string", "null"]}
        }
      },
      "description": "Constrained realization variants."
    },
    "domain": {
      "type": "string",
      "description": "Domain classification (e.g., 'daily_life', 'education', 'commerce', 'healthcare')."
    },
    "quality_tier": {
      "type": "string",
      "enum": ["GOLD", "SILVER", "SYNTHETIC"]
    },
    "human_review_status": {
      "type": "string",
      "enum": ["PENDING_REVIEW", "FLAGGED", "REJECTED", "HUMAN_APPROVED"]
    }
  },
  "additionalProperties": false
}
