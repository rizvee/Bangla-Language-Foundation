{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bangla-language-foundation.org/schemas/v0_1/source.schema.json",
  "title": "BLFSource",
  "description": "Schema for sources registered in the BLF research source registry with claim-level evidence binding, artifact-specific licensing, and semantic verification.",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "author_or_org",
    "source_tier",
    "language",
    "year",
    "verification_status",
    "citation"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$",
      "description": "Unique stable source identifier (e.g. BA-GRAM-2011)."
    },
    "canonical_resource_id": {
      "type": "string",
      "description": "Stable conceptual resource ID across mirrors/versions."
    },
    "title": {
      "type": "string",
      "description": "Full title of the publication, dataset, or resource."
    },
    "author_or_org": {
      "type": "string",
      "description": "Author(s), editors, or publishing institution."
    },
    "source_tier": {
      "type": "string",
      "enum": ["TIER_A", "TIER_B", "TIER_C", "TIER_D", "TIER_E"],
      "description": "BLF research source priority tier."
    },
    "language": {
      "type": "string",
      "description": "Primary language of source (e.g. 'bn', 'en', 'bn-BD')."
    },
    "region": {
      "type": ["string", "null"],
      "description": "Geographic focus (e.g. 'Bangladesh', 'Dhaka', 'West Bengal', 'Sylhet')."
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2100,
      "description": "Original publication or release year."
    },
    "edition": {
      "type": ["string", "null"],
      "description": "Specific edition or reprint details if distinct from original publication."
    },
    "version": {
      "type": ["string", "null"],
      "description": "Dataset or software release version."
    },
    "release": {
      "type": ["string", "null"],
      "description": "Specific benchmark or distribution release (e.g. 'UD v2.12')."
    },
    "publisher": {
      "type": ["string", "null"],
      "description": "Publisher name or academic institution."
    },
    "url": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Direct persistent canonical URL or repository link."
    },
    "identifier": {
      "type": ["string", "null"],
      "description": "Standard identifier such as ISBN, DOI, arXiv ID, ACL Anthology ID, or catalog ID."
    },
    "paper_id": {
      "type": ["string", "null"],
      "description": "Canonical paper identifier (e.g. 'arXiv:2206.14053', 'ACL:2022.findings-naacl.98')."
    },
    "mirror_of": {
      "type": ["string", "null"],
      "description": "Upstream resource ID if this record is a repository/HuggingFace mirror."
    },
    "derived_from": {
      "type": ["string", "null"],
      "description": "Upstream source ID if this dataset is derived from another corpus."
    },
    "supersedes": {
      "type": ["string", "null"],
      "description": "Previous source_id superseded by this updated record."
    },
    "copyright_status": {
      "type": ["string", "null"],
      "description": "Legal copyright state (e.g. 'Copyrighted', 'Public Domain', 'Statutory Public Notice', 'Open Access')."
    },
    "license": {
      "type": ["string", "null"],
      "description": "Explicit license governing the primary artifact (e.g., 'CC-BY-NC-SA-4.0', 'Apache-2.0', 'MIT', 'CC0-1.0', null if unspecified)."
    },
    "redistribution": {
      "type": ["string", "null"],
      "enum": ["open_redistribution", "derived_features_only", "restricted_or_requires_review", "restricted_internal", null],
      "description": "Allowed redistribution scope under BLF policy."
    },
    "artifacts": {
      "type": "array",
      "description": "Artifact-specific licensing and access breakdown (e.g., Paper vs Code vs Dataset vs Model).",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type"],
        "properties": {
          "artifact_id": {"type": "string"},
          "artifact_type": {
            "type": "string",
            "enum": ["PAPER", "CODE", "DATASET", "MODEL", "CORPUS", "ANNOTATIONS", "DOCUMENTATION", "CHECKPOINT", "ARCHIVE", "MONOGRAPH", "RULEBOOK", "DICTIONARY"]
          },
          "canonical_url": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]},
          "copyright_status": {"type": ["string", "null"]},
          "redistribution": {
            "type": ["string", "null"],
            "enum": ["open_redistribution", "derived_features_only", "restricted_or_requires_review", "restricted_internal", null]
          },
          "evidence_id": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "PROVISIONAL", "QUARANTINED", "REJECTED"],
      "description": "Epistemic verification state."
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "PROVISIONAL", "QUARANTINED", "REJECTED"]
        },
        "verified_at": {
          "type": "string",
          "description": "ISO date of verification audit."
        },
        "verification_method": {
          "type": "string",
          "description": "Method of verification."
        },
        "primary_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "canonical_url", "publisher_or_host", "evidence_type"],
            "properties": {
              "evidence_id": {"type": "string"},
              "canonical_url": {"type": "string"},
              "publisher_or_host": {"type": "string"},
              "evidence_type": {"type": "string"},
              "resource_title": {"type": "string"},
              "retrieved_title": {"type": "string"},
              "authors_if_applicable": {"type": "array", "items": {"type": "string"}},
              "identifier_if_applicable": {"type": "string"},
              "accessed_at": {"type": "string"},
              "locator": {"type": "string"},
              "supports_fields": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "claims": {
          "type": "array",
          "description": "Claim-level evidence bindings.",
          "items": {
            "type": "object",
            "required": ["claim_id", "field", "value", "evidence_id", "status"],
            "properties": {
              "claim_id": {"type": "string"},
              "field": {"type": "string"},
              "value": {},
              "evidence_id": {"type": "string"},
              "locator": {"type": "string"},
              "status": {
                "type": "string",
                "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "PROVISIONAL", "UNVERIFIED", "DISPUTED"]
              },
              "verified_at": {"type": "string"}
            }
          }
        },
        "verified_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unresolved_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "verifier_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "checksum": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 checksum of referenced digital artifact."
    },
    "citation": {
      "type": "string",
      "description": "Full bibliographic citation in standard academic format."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Methodological, extraction, or scope notes."
    }
  },
  "additionalProperties": false
}
