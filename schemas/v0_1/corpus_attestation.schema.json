{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bangla-language-foundation.org/schemas/v0_1/corpus_attestation.schema.json",
  "title": "BLFCorpusAttestation",
  "description": "Schema for empirical corpus and literature attestations in BLF, separating record validity from genuine external verification.",
  "type": "object",
  "required": [
    "attestation_id",
    "text",
    "normalized_text",
    "source_id",
    "source_type",
    "language_variety",
    "register",
    "construction_ids",
    "rule_ids",
    "exact_or_derived_text",
    "locator",
    "locator_type",
    "canonical_url_or_artifact",
    "retrieval_date",
    "verification_method",
    "verification_status",
    "copyright_handling"
  ],
  "properties": {
    "attestation_id": {
      "type": "string",
      "pattern": "^ATT-[A-Z0-9_-]+$",
      "description": "Unique attestation identifier (e.g. ATT-CORP-PHELA-01)."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Attested textual excerpt or representative linguistic example."
    },
    "normalized_text": {
      "type": "string",
      "minLength": 1,
      "description": "NFC normalized and cleaned Bangla text."
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$",
      "description": "Registered source ID from sources.json."
    },
    "artifact_id": {
      "type": ["string", "null"],
      "description": "Specific artifact ID within source (e.g. ART-PAPER-01, ART-DATA-01)."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "SCHOLARLY_GRAMMAR",
        "CONTEMPORARY_NEWS_PUBLIC",
        "GOVERNMENT_PUBLIC_PORTAL",
        "OPEN_ACCESS_RESEARCH_CORPUS",
        "SPOKEN_SPEECH_TRANSCRIPT",
        "LITERARY_PUBLIC_DOMAIN"
      ],
      "description": "Provenance category of the source."
    },
    "exact_or_derived_text": {
      "type": "string",
      "enum": [
        "EXACT_QUOTATION",
        "SCHOLARLY_EXAMPLE_DERIVED",
        "CORPUS_TOKEN_STREAM",
        "SYNTHESIZED_MINIMAL_PAIR"
      ],
      "description": "Whether the text is an exact verbatim extract or a derived illustrative example."
    },
    "locator": {
      "type": "string",
      "description": "Page number, section, paragraph, dataset record ID, or quarantine label."
    },
    "locator_type": {
      "type": "string",
      "enum": [
        "PAGE",
        "PARAGRAPH",
        "SECTION",
        "CORPUS_RECORD",
        "LINE",
        "DOCUMENT",
        "UNINDEXED_SPLIT_QUARANTINED"
      ],
      "description": "Structural type of the locator reference."
    },
    "canonical_url_or_artifact": {
      "type": "string",
      "description": "Accessible URL, DOI, or local verified artifact path."
    },
    "retrieval_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of evidence retrieval or audit."
    },
    "content_hash": {
      "type": ["string", "null"],
      "description": "SHA-256 hash of the exact excerpt or text stream when available."
    },
    "metadata_hash": {
      "type": ["string", "null"],
      "description": "SHA-256 hash of source metadata record."
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "INDEPENDENT_PAGE_AUDIT",
        "DIRECT_CORPUS_TOKEN_MATCH",
        "METADATA_ONLY_BIBLIOGRAPHIC_LOCATOR",
        "UNINDEXED_QUARANTINE",
        "HUMAN_EXPERT_VERIFIED"
      ],
      "description": "Audit methodology applied to this attestation record."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "PROVISIONAL",
        "LOCATOR_VERIFIED",
        "TEXT_VERIFIED",
        "FEATURE_VERIFIED",
        "HUMAN_REVIEWED",
        "REJECTED"
      ],
      "description": "Fine-grained epistemic verification status."
    },
    "language_variety": {
      "type": "string",
      "enum": [
        "BDSB_STANDARD",
        "BANGLADESH_CONVERSATIONAL",
        "SYLHETI_COLLOQUIAL",
        "CHATGAYA_COLLOQUIAL",
        "NOAKHAILLA_COLLOQUIAL",
        "CROSS_VARIETY"
      ],
      "description": "Geographic / sociolinguistic variety."
    },
    "register": {
      "type": "string",
      "enum": [
        "FORMAL_STANDARD",
        "COLLOQUIAL_STANDARD",
        "INFORMAL_CONVERSATIONAL",
        "LITERARY_SADHU",
        "OFFICIAL_GOVERNMENT"
      ],
      "description": "Stylistic register."
    },
    "construction_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CONST-[A-Z0-9_-]+$"},
      "description": "Linked construction IDs instantiated by this attestation."
    },
    "rule_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^RUL-[A-Z0-9_-]+$"},
      "description": "Linked linguistic rule IDs exemplified by this attestation."
    },
    "frame_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^FRAME-[A-Z0-9_-]+$"},
      "description": "Linked semantic frame IDs evoked by this attestation."
    },
    "copyright_handling": {
      "type": "string",
      "enum": [
        "SHORT_EXCERPT_RESEARCH_FAIR_USE",
        "OPEN_LICENSE_REPRODUCTION",
        "PUBLIC_DOMAIN_EXCERPT",
        "HASH_AND_LOCATOR_ONLY"
      ],
      "description": "Legal copyright handling designation."
    },
    "gloss": {
      "type": "string",
      "description": "Morpheme or word-level English gloss."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Linguistic or contextual audit notes."
    }
  },
  "additionalProperties": false
}
