{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bangla-language-foundation.org/schemas/v0_1/human_review_decision.schema.json",
  "title": "BLFHumanReviewSubmission",
  "description": "Schema for recording raw, blinded native-speaker review submissions with candidate-level acceptability and preference ratings.",
  "type": "object",
  "required": [
    "submission_id",
    "session_id",
    "reviewer_pseudonym",
    "reviewer_qualification",
    "native_bangladeshi_speaker",
    "native_variety",
    "opaque_item_id",
    "candidate_judgments",
    "preferred_candidates",
    "timestamp"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^REV-SUB-[A-Z0-9_-]+$",
      "description": "Unique identifier for this human submission record."
    },
    "session_id": {
      "type": "string",
      "pattern": "^SESS-[A-Z0-9_-]+$",
      "description": "Blinded review session identifier."
    },
    "reviewer_pseudonym": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9_-]+$",
      "description": "Pseudonymous identifier for the reviewer (e.g. REV-LINGUIST-01, REV-NATIVE-02)."
    },
    "reviewer_qualification": {
      "type": "string",
      "enum": [
        "NATIVE_LINGUIST",
        "NATIVE_EDUCATED_SPEAKER",
        "LANGUAGE_TEACHER",
        "NLP_ANNOTATOR",
        "OTHER"
      ],
      "description": "Reviewer linguistic qualification category."
    },
    "native_bangladeshi_speaker": {
      "type": "boolean",
      "description": "Whether the reviewer is a native speaker of Bangladeshi Bangla."
    },
    "native_variety": {
      "type": "string",
      "enum": [
        "BDSB_STANDARD",
        "DHAKA_COLLOQUIAL",
        "REGIONAL_BANGLADESH_OTHER"
      ],
      "description": "Broad regional/variety background of the reviewer."
    },
    "opaque_item_id": {
      "type": "string",
      "pattern": "^BLIND-[A-Z0-9_-]+$",
      "description": "Opaque reviewer-specific item identifier (e.g. BLIND-R1-A7K4)."
    },
    "candidate_judgments": {
      "type": "object",
      "description": "Independent acceptability and certainty ratings for each displayed candidate label (strictly 'A', 'B', 'C').",
      "minProperties": 2,
      "maxProperties": 3,
      "propertyNames": {
        "enum": ["A", "B", "C"]
      },
      "properties": {
        "A": {
          "type": "object",
          "required": ["acceptability", "certainty"],
          "properties": {
            "acceptability": {
              "type": "string",
              "enum": [
                "NATURAL_STANDARD",
                "NATURAL_COLLOQUIAL",
                "MARKED_BUT_VALID",
                "UNNATURAL",
                "UNGRAMMATICAL",
                "MEANING_DIFFERS",
                "NEEDS_CONTEXT",
                "UNSURE"
              ]
            },
            "certainty": {
              "type": "string",
              "enum": ["VERY_SURE", "SURE", "SOMEWHAT_UNCERTAIN", "GUESSING"]
            }
          },
          "additionalProperties": false
        },
        "B": {
          "type": "object",
          "required": ["acceptability", "certainty"],
          "properties": {
            "acceptability": {
              "type": "string",
              "enum": [
                "NATURAL_STANDARD",
                "NATURAL_COLLOQUIAL",
                "MARKED_BUT_VALID",
                "UNNATURAL",
                "UNGRAMMATICAL",
                "MEANING_DIFFERS",
                "NEEDS_CONTEXT",
                "UNSURE"
              ]
            },
            "certainty": {
              "type": "string",
              "enum": ["VERY_SURE", "SURE", "SOMEWHAT_UNCERTAIN", "GUESSING"]
            }
          },
          "additionalProperties": false
        },
        "C": {
          "type": "object",
          "required": ["acceptability", "certainty"],
          "properties": {
            "acceptability": {
              "type": "string",
              "enum": [
                "NATURAL_STANDARD",
                "NATURAL_COLLOQUIAL",
                "MARKED_BUT_VALID",
                "UNNATURAL",
                "UNGRAMMATICAL",
                "MEANING_DIFFERS",
                "NEEDS_CONTEXT",
                "UNSURE"
              ]
            },
            "certainty": {
              "type": "string",
              "enum": ["VERY_SURE", "SURE", "SOMEWHAT_UNCERTAIN", "GUESSING"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "preferred_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["A", "B", "C", "NONE"]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "description": "List of preferred candidate labels (allows multiple equivalents like ['A', 'B'] or ['NONE'] if all are flawed)."
    },
    "correction": {
      "type": ["string", "null"],
      "description": "Suggested natural/grammatical correction in standard Bangla orthography if needed."
    },
    "comments": {
      "type": ["string", "null"],
      "description": "Linguistic notes, register nuances, or context dependencies."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z?$",
      "description": "ISO UTC timestamp when the review was submitted."
    }
  },
  "additionalProperties": false
}
