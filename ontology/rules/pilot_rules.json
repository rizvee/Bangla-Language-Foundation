      "rule_type": "VERBAL_INFLECTION",
      "input_conditions": {
        "tense": "future",
        "aspect": "simple"
      },
      "structural_pattern": "VerbStem + '-b-' + Suffix[Person=1:-o, Person=2_Ord:-e, Person=2_Hon:-en, Person=2_Int:-i, Person=3_Ord:-e, Person=3_Hon:-en]",
      "morphological_features": {"Tense": "Fut", "Aspect": "Simple"},
      "constraints": [],
      "output_relation": "finite_future_verb",
      "language_variety": "BDSB_STANDARD",
      "register": "colloquial_standard",
