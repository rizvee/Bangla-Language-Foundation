  "rules": [
    {
      "rule_id": "RUL-SYN-SOV-DEFAULT",
      "supporting_claim_ids": ["CLM-SYN-SOV-01"],
      "rule_type": "SYNTACTIC_ORDERING",
      "input_conditions": {
        "clause_type": "matrix_declarative",
        "voice": "active",
        "pragmatic_focus": "neutral"
      },
      "structural_pattern": "[Subject:NP] ([IndirectObject:NP]) ([DirectObject:NP]) [Verb:VP]",
      "morphological_features": {},
      "constraints": ["Verb must remain final in unmarked declarative clauses."],
      "output_relation": "root_clause",
      "language_variety": "BDSB_STANDARD",
      "register": "formal_standard",
      "productivity": "FULLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [
        {
          "exception_type": "PRAGMATIC_SCRAMBLING",
          "description": "Object fronting under contrastive focus.",
          "examples": ["Boi-ta ami porechi."]
        }
      ],
      "notes": "Canonical clausal template for BDSB generation."
    },
    {
      "rule_id": "RUL-SYN-SCRAMBLE-TOPICAL",
      "supporting_claim_ids": ["CLM-SYN-SCRAMBLE-02"],
      "rule_type": "TOPICALIZATION_PERMUTATION",
      "input_conditions": {
        "clause_type": "matrix_declarative",
        "focus_target": "DirectObject"
      },
      "structural_pattern": "[DirectObject:NP] [Subject:NP] [Verb:VP]",
      "morphological_features": {},
      "constraints": ["Thematic role assignment remains governed by case markers, not position."],
      "output_relation": "topicalized_clause",
      "language_variety": "BDSB_STANDARD",
      "register": "colloquial_standard",
      "productivity": "HIGHLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [],
      "notes": "Object topicalization permutation."
    },
    {
      "rule_id": "RUL-SYN-PRODROP-MATRIX",
      "supporting_claim_ids": ["CLM-SYN-PRODROP-03"],
      "rule_type": "SYNTACTIC_ORDERING",
      "input_conditions": {
        "discourse_context": "salient_subject_referent",
        "pragmatic_focus": "non_contrastive"
      },
      "structural_pattern": "[Ø:Subject] ([Object:NP]) [Verb:VP[+PersonAgreement]]",
      "morphological_features": {"Subject": "null_pro"},
      "constraints": ["Overt pronoun must not be omitted if bearing contrastive focus clitic -i."],
      "output_relation": "pro_drop_clause",
      "language_variety": "BDSB_STANDARD",
      "register": "colloquial_standard",
      "productivity": "FULLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [],
      "notes": "Generates natural pro-drop sentence variants."
    },
    {
      "rule_id": "RUL-SYN-DATSUBJ-EXPERIENCER",
      "supporting_claim_ids": ["CLM-SYN-DATSUBJ-04"],
      "rule_type": "CASE_MARKING_SELECTION",
      "input_conditions": {
        "predicate_type": "experiencer_or_obligative",
        "thematic_role": "experiencer"
      },
      "structural_pattern": "[Experiencer:NP[Case=Gen|Dat]] ([Theme:NP[Case=Nom]]) [Predicate:VP[Person=3,Polite=Neutral]]",
      "morphological_features": {"Experiencer": "Case=Gen/Dat", "Verb": "Person=3"},
      "constraints": ["Verb never agrees in person with the genitive/dative experiencer."],
      "output_relation": "experiencer_subject_construction",
      "language_variety": "BDSB_STANDARD",
      "register": "colloquial_standard",
      "productivity": "HIGHLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [],
      "notes": "Non-nominative subject realization rule."
    },
    {
      "rule_id": "RUL-MSYN-DOM-ACCUSATIVE",
      "supporting_claim_ids": ["CLM-MSYN-DOM-05"],
      "rule_type": "CASE_MARKING_SELECTION",
      "input_conditions": {
        "thematic_role": "patient_direct_object",
        "semantic_features": {"animate": true, "definite": true}
      },
      "structural_pattern": "[DirectObject:NP] + '-ke'",
      "morphological_features": {"Case": "Acc"},
      "constraints": ["Inanimate direct objects in unmarked contexts take zero suffix."],
      "output_relation": "differential_object_marked",
      "language_variety": "BDSB_STANDARD",
      "register": "formal_standard",
      "productivity": "FULLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [
        {
          "exception_type": "NON_SPECIFIC_GENERIC_HUMAN",
          "description": "Generic human profession nouns in non-specific contexts retain zero marking.",
          "examples": ["Daktar dako (Call a doctor)."]
        }
      ],
      "notes": "DOM selection rule in BDSB."
    },
    {
      "rule_id": "RUL-MSYN-HON-AGREEMENT",
      "supporting_claim_ids": ["CLM-MSYN-PRON-HON-06"],
      "rule_type": "HONORIFIC_AGREEMENT",
      "input_conditions": {
        "subject_person": ["2", "3"],
        "honorific_tier": ["HONORIFIC", "FAMILIAR", "INTIMATE"]
      },
      "structural_pattern": "[Subject:Pronoun[Person=P, Polite=T]] ... [Verb:VP[Person=P, Polite=T]]",
      "morphological_features": {"Agreement": "Person_Polite_Match"},
      "constraints": ["Mismatched pronoun-verb honorific combinations are strictly ungrammatical."],
      "output_relation": "honorific_agreement_bound",
      "language_variety": "BDSB_STANDARD",
      "register": "cross_register",
      "productivity": "FULLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [],
      "notes": "Honorific morphosyntactic consistency rule."
    },
    {
      "rule_id": "RUL-MORPH-PRES-INFLECTION",
      "supporting_claim_ids": ["CLM-MORPH-PRES-07"],
      "rule_type": "VERBAL_INFLECTION",
      "input_conditions": {
        "tense": "present",
        "aspect": "simple"
      },
      "structural_pattern": "VerbStem + Suffix[Person=1:-i, Person=2_Ord:-o, Person=2_Hon:-en, Person=2_Int:-is, Person=3_Ord:-e, Person=3_Hon:-en]",
      "morphological_features": {"Tense": "Pres", "Aspect": "Simple"},
      "constraints": ["Stem-vowel mutations apply to monosyllabic open stems."],
      "output_relation": "finite_present_verb",
      "language_variety": "BDSB_STANDARD",
      "register": "colloquial_standard",
      "productivity": "FULLY_PRODUCTIVE",
      "confidence": "HIGH",
      "status": "ACTIVE",
      "exceptions": [],
      "notes": "Simple present verbal inflection rule."
    },
    {
      "rule_id": "RUL-MORPH-CONT-ASPECT",
      "supporting_claim_ids": ["CLM-MORPH-CONT-08"],
      "rule_type": "VERBAL_INFLECTION",
      "input_conditions": {
        "aspect": "continuous",
